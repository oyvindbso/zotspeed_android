<?xml version="1.0" encoding="utf-8"?>
<!-- Cover-screen reader widget. Only RemoteViews-compatible views are used. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000"
    android:orientation="vertical"
    android:paddingStart="@dimen/widget_pad_h"
    android:paddingTop="8dp"
    android:paddingEnd="@dimen/widget_pad_h"
    android:paddingBottom="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/widget_header"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_name"
            android:textColor="#99DADADA"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:textColor="#99DADADA"
            android:textSize="12sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Must match WidgetPager's line-breaking settings exactly. -->
        <TextView
            android:id="@+id/widget_page"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:breakStrategy="simple"
            android:fontFamily="serif"
            android:hyphenationFrequency="none"
            android:includeFontPadding="false"
            android:lineSpacingMultiplier="1.15"
            android:text="@string/widget_empty"
            android:textColor="#FFDADADA"
            android:textSize="16sp" />

        <!-- Tap zones: left third = previous page, rest = next page. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/widget_tap_prev"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <FrameLayout
                android:id="@+id/widget_tap_next"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/widget_footer"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/widget_prev"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:background="@null"
            android:contentDescription="Previous page"
            android:src="@drawable/ic_widget_prev" />

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="#99DADADA"
            android:textSize="12sp" />

        <ImageButton
            android:id="@+id/widget_open"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:background="@null"
            android:contentDescription="Open in ZotSpeed"
            android:src="@drawable/ic_widget_open" />

        <ImageButton
            android:id="@+id/widget_next"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:background="@null"
            android:contentDescription="Next page"
            android:src="@drawable/ic_widget_next" />
    </LinearLayout>
</LinearLayout>
